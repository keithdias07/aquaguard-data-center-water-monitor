{
  "manifest_version": 3,
  "name": "AquaGuard Prompt Optimizer",
  "short_name": "AquaGuard",
  "version": "0.2.1",
  "description": "Shortens verbose AI prompts locally before you send them. Automatic or manual, one-click Undo, never sends for you.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "AquaGuard Prompt Optimizer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/engine/tokenizer.js",
        "src/engine/features.js",
        "src/engine/rules.js",
        "src/engine/compressor.js",
        "src/engine/diff.js",
        "src/engine/impact.js",
        "src/shared/settings.js",
        "src/content/adapters.js",
        "src/content/field-io.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
